PORT=5000
# MongoDB Atlas, including the database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Empty = in-memory development DB with demo data (resets on restart).
MONGO_URI=
JWT_SECRET=
BASE_API_URL=api
CLIENT_URL=http://localhost:3000
# Admin account seeded/refreshed on startup (skipped when either is empty).
# Left empty with no MONGO_URI, the in-memory dev DB gets a DEMO admin:
#   admin@imprimo.local / ImprimoDemo@123  (development only — never use in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cloudinary (Dashboard → API Keys). Empty in development = images saved to ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Copy to .env (never commit it) or set these in your host's environment settings.

# ── Required in production ───────────────────────────────────────────
# MongoDB Atlas, including the database name (MONGODB_URI is accepted as an alias), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Empty in development = in-memory DB with demo data (resets on restart).
MONGO_URI=
# Long random string used to sign login tokens (the server will not start without it).
JWT_SECRET=
# Cloudinary (Dashboard → API Keys). Empty in development = images saved to ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional ─────────────────────────────────────────────────────────
# Port for `node index.js`; most hosts set this themselves.
PORT=5000
# Creates the first admin account on startup if it does not exist yet (both required).
# With no MONGO_URI (development only) a DEMO admin is created instead:
#   admin@imprimo.local / ImprimoDemo@123 — never use in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Customer site URL: used for social-login redirects and added to the CORS allowlist
# (https://imprimo-frontend.vercel.app and https://imprimo-admin.vercel.app are always allowed;
# http://localhost:3000/3001 only outside production).
CLIENT_URL=http://localhost:3001
# Read but not used for routing — the API is always mounted at /api.
BASE_API_URL=api
